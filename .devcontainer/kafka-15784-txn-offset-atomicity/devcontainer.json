{
  "name": "Bug Bench - kafka-15784-txn-offset-atomicity",
  "build": {
    "dockerfile": "../../docker/kafka.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-case-kafka-15784-txn-offset-atomicity-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/kafka-15784-txn-offset-atomicity,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/kafka-15784-txn-offset-atomicity",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/kafka-15784-txn-offset-atomicity ~/bug-bench/kafka-15784-txn-offset-atomicity",
  "customizations": {
    "vscode": {
      "extensions": ["scala-lang.scala"]
    }
  }
}
