{
  "name": "DDBench - zookeeper-4643-sync-epoch-ordering",
  "image": "bug-bench/zookeeper",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-f4e9ef09c531,target=/workspace,type=volume",
    "source=bug-bench-deps-f4e9ef09c531,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/zookeeper-4643-sync-epoch-ordering,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ]
    }
  }
}
