{
  "name": "Bug Bench - zookeeper-4643-sync-epoch-ordering",
  "build": {
    "dockerfile": "../../docker/zookeeper.Dockerfile"
  },
  "mounts": [
    "source=bug-bench-zookeeper-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/zookeeper-4643-sync-epoch-ordering,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/zookeeper-4643-sync-epoch-ordering",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/zookeeper-4643-sync-epoch-ordering ~/bug-bench/zookeeper-4643-sync-epoch-ordering",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vscjava.vscode-maven"]
    }
  }
}
