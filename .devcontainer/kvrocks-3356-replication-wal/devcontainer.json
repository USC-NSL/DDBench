{
  "name": "Bug Bench - kvrocks-3356-replication-wal",
  "build": {
    "dockerfile": "../../docker/kvrocks.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--cap-add=NET_ADMIN"
  ],
  "mounts": [
    "source=bug-bench-kvrocks-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder},target=/repo,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/kvrocks-3356-replication-wal",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/kvrocks-3356-replication-wal ~/bug-bench/kvrocks-3356-replication-wal",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
