{
  "name": "Bug Bench - kvrocks-3339-xreadgroup-double",
  "build": {
    "dockerfile": "../../docker/kvrocks.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-kvrocks-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/kvrocks-3339-xreadgroup-double,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/kvrocks-3339-xreadgroup-double",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/kvrocks-3339-xreadgroup-double ~/bug-bench/kvrocks-3339-xreadgroup-double",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
