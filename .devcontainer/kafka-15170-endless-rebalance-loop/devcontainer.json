{
  "name": "DDBench - kafka-15170-endless-rebalance-loop",
  "image": "bug-bench/kafka",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-08cd5e409fe6,target=/workspace,type=volume",
    "source=bug-bench-deps-08cd5e409fe6,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/kafka-15170-endless-rebalance-loop,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "scalameta.metals"
      ]
    }
  }
}
