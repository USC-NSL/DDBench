{
  "name": "Bug Bench - etcd-20221-watch-restore-revision",
  "build": {
    "dockerfile": "../../docker/etcd.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-case-etcd-20221-watch-restore-revision-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/etcd-20221-watch-restore-revision,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/etcd-20221-watch-restore-revision",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/etcd-20221-watch-restore-revision ~/bug-bench/etcd-20221-watch-restore-revision",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
