{
  "name": "Bug Bench - dragonfly-6753-populate-sigfpe",
  "build": {
    "dockerfile": "../../docker/dragonfly.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-case-dragonfly-6753-populate-sigfpe-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/dragonfly-6753-populate-sigfpe,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/dragonfly-6753-populate-sigfpe",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/dragonfly-6753-populate-sigfpe ~/bug-bench/dragonfly-6753-populate-sigfpe",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
