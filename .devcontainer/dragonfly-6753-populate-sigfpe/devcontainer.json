{
  "name": "DDBench - dragonfly-6753-populate-sigfpe",
  "image": "bug-bench/dragonfly",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-a3bf411f98f8,target=/workspace,type=volume",
    "source=bug-bench-deps-a3bf411f98f8,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/dragonfly-6753-populate-sigfpe,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
