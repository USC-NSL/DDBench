{
  "name": "DDBench - nats-7308-delete-nonexistent-reset",
  "image": "bug-bench/nats",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-fa4ebf7ee134,target=/workspace,type=volume",
    "source=bug-bench-deps-fa4ebf7ee134,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/nats-7308-delete-nonexistent-reset,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
