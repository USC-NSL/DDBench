{
  "name": "DDBench - kvrocks-3315-zdiff-crash",
  "image": "bug-bench/kvrocks",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-37e9b6c85281,target=/workspace,type=volume",
    "source=bug-bench-deps-37e9b6c85281,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/kvrocks-3315-zdiff-crash,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "golang.go"
      ]
    }
  }
}
