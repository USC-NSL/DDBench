{
  "name": "Bug Bench - rocksdb-10751-stalled-writes-shutdown",
  "build": {
    "dockerfile": "../../docker/rocksdb.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-rocksdb-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/rocksdb-10751-stalled-writes-shutdown,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/rocksdb-10751-stalled-writes-shutdown",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/rocksdb-10751-stalled-writes-shutdown ~/bug-bench/rocksdb-10751-stalled-writes-shutdown",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
