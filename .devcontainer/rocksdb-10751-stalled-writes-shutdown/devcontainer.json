{
  "name": "DDBench - rocksdb-10751-stalled-writes-shutdown",
  "image": "bug-bench/rocksdb",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-db0b31c2894d,target=/workspace,type=volume",
    "source=bug-bench-deps-db0b31c2894d,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/rocksdb-10751-stalled-writes-shutdown,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
