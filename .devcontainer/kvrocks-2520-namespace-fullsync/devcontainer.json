{
  "name": "Bug Bench - kvrocks-2520-namespace-fullsync",
  "build": {
    "dockerfile": "../../docker/kvrocks.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-case-kvrocks-2520-namespace-fullsync-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/kvrocks-2520-namespace-fullsync,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/kvrocks-2520-namespace-fullsync",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/kvrocks-2520-namespace-fullsync ~/bug-bench/kvrocks-2520-namespace-fullsync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
