{
  "name": "Bug Bench - seastar-2202-cross-shard-realloc",
  "build": {
    "dockerfile": "../../docker/seastar.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--cpus=2"
  ],
  "mounts": [
    "source=bug-bench-seastar-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/seastar-2202-cross-shard-realloc,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/seastar-2202-cross-shard-realloc",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/seastar-2202-cross-shard-realloc ~/bug-bench/seastar-2202-cross-shard-realloc",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
