{
  "name": "Bug Bench - nats-7852-filter-perf",
  "build": {
    "dockerfile": "../../docker/nats.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-nats-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder},target=/repo,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/nats-7852-filter-perf",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/nats-7852-filter-perf ~/bug-bench/nats-7852-filter-perf",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
