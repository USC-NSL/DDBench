{
  "name": "Bug Bench - nats-7718-subscription-leak",
  "build": {
    "dockerfile": "../../docker/nats.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-nats-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder},target=/repo,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/nats-7718-subscription-leak",
  "postCreateCommand": "bash /repo/docker/bench-init.sh nats-7718-subscription-leak",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
