{
  "name": "Bug Bench - dragonfly-6907-ftsearch-vector-crash",
  "build": {
    "dockerfile": "../../docker/dragonfly.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-dragonfly-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder},target=/repo,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/dragonfly-6907-ftsearch-vector-crash",
  "postCreateCommand": "bash /repo/docker/bench-init.sh dragonfly-6907-ftsearch-vector-crash",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
