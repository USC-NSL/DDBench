{
  "name": "DDBench - etcd-20893-force-new-cluster-learner",
  "image": "bug-bench/etcd",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-ws-730fa6d7a24d,target=/workspace,type=volume",
    "source=bug-bench-deps-730fa6d7a24d,target=/deps,type=volume",
    "source=${localWorkspaceFolder}/cases/etcd-20893-force-new-cluster-learner,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/src",
  "containerEnv": {
    "BENCH_WORKDIR": "/workspace/src",
    "GOMODCACHE": "/deps/go/mod",
    "GOCACHE": "/deps/go/build",
    "CARGO_HOME": "/deps/cargo",
    "GRADLE_USER_HOME": "/deps/gradle",
    "MAVEN_OPTS": "-Dmaven.repo.local=/deps/m2"
  },
  "postCreateCommand": "git config --global --add safe.directory '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
