{
  "name": "Bug Bench - clickhouse-98079-keeper-addwatch",
  "build": {
    "dockerfile": "../../docker/clickhouse.Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "mounts": [
    "source=bug-bench-case-clickhouse-98079-keeper-addwatch-src,target=/workspace,type=volume",
    "source=${localWorkspaceFolder}/cases/clickhouse-98079-keeper-addwatch,target=/bench,type=bind,readonly"
  ],
  "workspaceFolder": "/workspace/worktrees/clickhouse-98079-keeper-addwatch",
  "postCreateCommand": "mkdir -p ~/bug-bench && ln -sfn /workspace/worktrees/clickhouse-98079-keeper-addwatch ~/bug-bench/clickhouse-98079-keeper-addwatch",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
