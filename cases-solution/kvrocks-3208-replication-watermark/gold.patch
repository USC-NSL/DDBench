         }
         incr_bulk_len_ = line.length > 0 ? std::strtoull(line.get() + 1, nullptr, 10) : 0;
@@ -714,6 +716,8 @@ ReplicationThread::CBState ReplicationThread::incrementBatchLoopCB(bufferevent *
